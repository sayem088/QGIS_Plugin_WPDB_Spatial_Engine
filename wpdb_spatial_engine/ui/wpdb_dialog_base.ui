        </property>
        <item>
         <widget class="QLabel" name="lblHeaderTitle">
          <property name="text">
           <string>&lt;span style="font-size: 14pt; font-weight: 800; color: #f8fafc;"&gt;WPDB Spatial Engine&lt;/span&gt; &lt;span style="font-size: 8.5pt; font-weight: bold; background-color: #0284c7; color: #ffffff; border-radius: 4px; padding: 2px 7px;"&gt;v1.0.0&lt;/span&gt;</string>
          </property>
         </widget>
        </item>
        <item>
         <widget class="QLabel" name="lblHeaderSubtitle">
